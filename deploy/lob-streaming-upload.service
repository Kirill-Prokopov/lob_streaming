[Unit]
Description=Upload closed lob_streaming recordings to Yandex Disk
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Code/lob_streaming
ExecStart=/root/Code/.venv_lob_streaming/bin/python -m lob_streaming.upload --out-dir data/orderbook --secrets-path '/root/Code/.secrets_obs'
