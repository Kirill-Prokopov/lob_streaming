[Unit]
Description=Compress, upload and clean up closed lob_streaming recordings (batch 2, Yandex Disk)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Code/lob_streaming
ExecStart=/root/Code/.venv_lob_streaming/bin/python -m lob_streaming.upload --out-dir '/root/Code/lob_data_2' --secrets-path '/root/Code/.secrets_obs' --remote-root 'app:/orderbook'
