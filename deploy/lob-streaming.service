[Unit]
Description=LOB streaming recorder (MXZ6@RTSX, MMZ6@RTSX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Code/lob_streaming
ExecStart=/root/Code/.venv_lob_streaming/bin/python -m lob_streaming.orderbook MXZ6@RTSX MMZ6@RTSX --out-dir '/root/Code/lob_data' --secrets-file '/root/Code/.secrets_obs'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
